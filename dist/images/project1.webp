<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="60%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#3b82f6" />
    </linearGradient>
    <linearGradient id="glow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#grad1)" />
  <circle cx="650" cy="120" r="180" fill="rgba(56, 189, 248, 0.08)" />
  <circle cx="150" cy="380" r="140" fill="rgba(129, 140, 248, 0.06)" />
  
  <!-- Geometric Logo Concept -->
  <g transform="translate(400, 210)" text-anchor="middle">
    <polygon points="0,-70 60,35 -60,35" fill="none" stroke="url(#glow)" stroke-width="4" stroke-linejoin="round" />
    <circle cx="0" cy="5" r="22" fill="#38bdf8" fill-opacity="0.25" stroke="#38bdf8" stroke-width="3" />
    <text y="100" font-family="'Cairo', system-ui, sans-serif" font-size="24" font-weight="900" fill="#ffffff">شركة تقنية ناشئة</text>
    <text y="130" font-family="'Inter', system-ui, sans-serif" font-size="14" font-weight="600" fill="#94a3b8" letter-spacing="2">CLOUD TECH BRAND IDENTITY</text>
  </g>
</svg>
