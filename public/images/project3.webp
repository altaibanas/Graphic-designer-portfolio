<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#022c22" />
      <stop offset="50%" stop-color="#064e3b" />
      <stop offset="100%" stop-color="#0f766e" />
    </linearGradient>
    <linearGradient id="emerald" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#6ee7b7" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#grad3)" />
  <circle cx="200" cy="150" r="120" fill="rgba(52, 211, 153, 0.08)" />
  
  <g transform="translate(400, 210)" text-anchor="middle">
    <!-- Brochure Graphic -->
    <rect x="-45" y="-65" width="90" height="75" rx="6" fill="none" stroke="url(#emerald)" stroke-width="3" />
    <line x1="-30" y1="-45" x2="30" y2="-45" stroke="url(#emerald)" stroke-width="2" />
    <line x1="-30" y1="-30" x2="10" y2="-30" stroke="url(#emerald)" stroke-width="2" />
    <line x1="-30" y1="-15" x2="20" y2="-15" stroke="url(#emerald)" stroke-width="2" />
    <text y="100" font-family="'Cairo', system-ui, sans-serif" font-size="24" font-weight="900" fill="#ffffff">كتيب عقاري فاخر</text>
    <text y="130" font-family="'Inter', system-ui, sans-serif" font-size="14" font-weight="600" fill="#6ee7b7" letter-spacing="2">LUXURY REAL ESTATE BROCHURE</text>
  </g>
</svg>
