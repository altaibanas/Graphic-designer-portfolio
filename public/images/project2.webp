<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#18181b" />
      <stop offset="50%" stop-color="#27272a" />
      <stop offset="100%" stop-color="#7c2d12" />
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#f59e0b" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#grad2)" />
  <circle cx="700" cy="400" r="160" fill="rgba(251, 191, 36, 0.08)" />
  
  <g transform="translate(400, 210)" text-anchor="middle">
    <!-- Restaurant Fork & Spoon Art -->
    <circle cx="0" cy="-20" r="55" fill="none" stroke="url(#gold)" stroke-width="3" />
    <path d="M-15,-40 L-15,0 M-20,-40 L-20,-20 M-10,-40 L-10,-20 M15,-40 C25,-40 25,-20 15,-10 L15,0" stroke="url(#gold)" stroke-width="3" stroke-linecap="round" fill="none" />
    <text y="100" font-family="'Cairo', system-ui, sans-serif" font-size="24" font-weight="900" fill="#ffffff">حملة مطعم راقٍ</text>
    <text y="130" font-family="'Inter', system-ui, sans-serif" font-size="14" font-weight="600" fill="#fbbf24" letter-spacing="2">LUXURY RESTAURANT CAMPAIGN</text>
  </g>
</svg>
