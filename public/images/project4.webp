<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grad4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#142416" />
      <stop offset="50%" stop-color="#1b381e" />
      <stop offset="100%" stop-color="#365314" />
    </linearGradient>
    <linearGradient id="limeGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#a3e635" />
      <stop offset="100%" stop-color="#bef264" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#grad4)" />
  <circle cx="650" cy="180" r="140" fill="rgba(163, 230, 53, 0.08)" />
  
  <g transform="translate(400, 210)" text-anchor="middle">
    <!-- Packaging Box / Leaf Graphic -->
    <polygon points="0,-60 50,-35 0,-10 -50,-35" fill="none" stroke="url(#limeGrad)" stroke-width="3" />
    <polygon points="-50,-35 0,-10 0,40 -50,15" fill="rgba(163, 230, 53, 0.15)" stroke="url(#limeGrad)" stroke-width="3" />
    <polygon points="50,-35 0,-10 0,40 50,15" fill="rgba(163, 230, 53, 0.25)" stroke="url(#limeGrad)" stroke-width="3" />
    <text y="100" font-family="'Cairo', system-ui, sans-serif" font-size="24" font-weight="900" fill="#ffffff">تغليف منتج غذائي صحي</text>
    <text y="130" font-family="'Inter', system-ui, sans-serif" font-size="14" font-weight="600" fill="#bef264" letter-spacing="2">ORGANIC FOOD PACKAGING</text>
  </g>
</svg>
