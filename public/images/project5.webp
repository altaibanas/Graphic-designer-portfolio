<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grad5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1f142b" />
      <stop offset="50%" stop-color="#2e1065" />
      <stop offset="100%" stop-color="#4c1d95" />
    </linearGradient>
    <linearGradient id="roseGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="100%" stop-color="#fb7185" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#grad5)" />
  <circle cx="250" cy="160" r="140" fill="rgba(244, 63, 94, 0.08)" />
  
  <g transform="translate(400, 210)" text-anchor="middle">
    <!-- Diamond / Haute Couture Icon -->
    <polygon points="0,-60 45,-30 0,35 -45,-30" fill="none" stroke="url(#roseGrad)" stroke-width="3" />
    <line x1="-45" y1="-30" x2="45" y2="-30" stroke="url(#roseGrad)" stroke-width="2" />
    <line x1="0" y1="-60" x2="0" y2="35" stroke="url(#roseGrad)" stroke-width="2" />
    <text y="100" font-family="'Cairo', system-ui, sans-serif" font-size="24" font-weight="900" fill="#ffffff">علامة تجارية للأزياء الفاخرة</text>
    <text y="130" font-family="'Inter', system-ui, sans-serif" font-size="14" font-weight="600" fill="#fb7185" letter-spacing="2">HAUTE COUTURE BRAND IDENTITY</text>
  </g>
</svg>
